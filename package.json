{
  "name": "mola",
  "version": "1.0.0",
  "description": "Pomodoro, mikro mola ve esneme hatirlaticisi \u2014 uzun oturma seanslarini saglikli hale getirir.",
  "author": "Serhat Mazlum Cetin",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "esbuild src/main/engine.ts --bundle --format=cjs --platform=node --alias:@shared=./src/shared --outfile=node_modules/.cache/engine.cjs --log-level=warning && node test/engine.test.cjs",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
